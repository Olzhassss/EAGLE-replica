{
  "schema_version": 1,
  "profile": "checkout-compatibility",
  "decision_seconds": 4,
  "episode_steps": 20,
  "warmup_seconds": 0,
  "observation_view": "configured",
  "embedding": {
    "order": 1,
    "eval_points": 1,
    "normalization": "legacy"
  },
  "reward": {
    "kind": "legacy",
    "overprovisioning_penalty": 5,
    "throughput_scale": 40
  },
  "learning": {
    "batch_size": 20,
    "actor_lr": 0.0001,
    "critic_lr": 0.001,
    "estimator_lr": 0.001,
    "estimator_input": "next_state_scaled_actions",
    "pruning": {
      "mode": "dense"
    }
  }
}